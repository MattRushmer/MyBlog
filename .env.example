# Copy this file to .env.local and fill in real values. .env.local is
# git-ignored; never commit real secrets.

# ---------------------------------------------------------------------------
# Shared (both modes)
# ---------------------------------------------------------------------------

# "local" runs with zero AWS access (JSON files + local disk uploads).
# "aws" switches every adapter to its DynamoDB/S3/Cognito implementation.
DEPLOY_TARGET=local

# Public base URL of the site. Used for canonical links, RSS, and OG tags.
SITE_URL=http://localhost:3000

# Max accepted upload size in bytes. Enforced in both modes.
MAX_UPLOAD_BYTES=15728640

# How long a presigned/local upload ticket stays valid.
UPLOAD_TICKET_TTL_SECONDS=300

# How long an admin session cookie stays valid before requiring re-login.
SESSION_TTL_SECONDS=43200

# ---------------------------------------------------------------------------
# Local mode only (DEPLOY_TARGET=local)
# ---------------------------------------------------------------------------

# Admin login username.
ADMIN_USERNAME=

# bcrypt hash of the admin password. Generate with:
#   npm run hash-password -- "your-password-here"
# The app refuses to enable /admin if this is missing - never a default.
ADMIN_PASSWORD_HASH=

# Secret used to sign the admin session cookie (HS256 JWS). Must be at
# least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Where the local JSON content store and uploaded files live. Git-ignored.
DATA_DIR=./data
UPLOADS_DIR=./data/uploads

# ---------------------------------------------------------------------------
# AWS mode only (DEPLOY_TARGET=aws) - not needed to run locally
# ---------------------------------------------------------------------------

AWS_REGION=ap-southeast-2
CONTENT_TABLE_NAME=
ISR_TABLE_NAME=
PHOTOS_BUCKET_NAME=
CDN_DOMAIN=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
